{
  "name": "bonded-work",
  "private": true,
  "description": "Kaspa-native covenant escrow for agent-to-agent jobs",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test -w @bonded-work/protocol && npm test -w @bonded-work/verifier",
    "demo:happy": "node apps/cli/demo-happy.js",
    "demo:fail": "node apps/cli/demo-fail.js",
    "demo:persist": "node apps/cli/demo-persist.js",
    "demo:covenant": "node apps/cli/demo-covenant.js",
    "demo:harness": "node apps/cli/demo-harness.js",
    "demo:lock-txid": "node apps/cli/demo-lock-txid.js",
    "demo:opensilver": "node apps/cli/demo-opensilver.js",
    "bonded": "node apps/cli/bonded.js",
    "test:cli": "node --test apps/cli/bonded.test.js",
    "test:all": "npm test && npm run test:cli",
    "demo:lifecycle": "node apps/cli/demo-lifecycle.js",
    "demo:compose": "node apps/cli/demo-compose.js",
    "demo:verifier": "node apps/cli/demo-verifier.js"
  },
  "bin": {
    "bonded": "apps/cli/bonded.js"
  }
}
